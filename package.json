{
  "name": "kakiwake-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "tauri": "tauri",
    "lint": "npm run lint:web && npm run lint:rust",
    "lint:web": "prettier --check . && eslint . && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:rust": "cargo fmt --all --check && cargo clippy -p kakiwake-core --all-targets -- -D warnings",
    "format": "prettier --write . && cargo fmt --all",
    "test": "cargo test -p kakiwake-core",
    "eval": "cargo run -p kakiwake-core --bin kakiwake-eval --"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tauri-apps/cli": "2.12.6",
    "@tsconfig/svelte": "5.0.9",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "8.3.8"
  }
}
